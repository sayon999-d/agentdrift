# Copy to .env and fill in
# Supabase Cloud MCP server (agentdrift/mcp/cloud_server.py + Docker/Render)
# Direct Postgres URL, port 5432 (NOT the pooler URL):
SUPABASE_DATABASE_URL=
# Fallback alias honored by every backend:
AGENTDRIFT_DATABASE_URL=
# Supabase Auth JWT secret (Dashboard -> Auth -> Signer keys): verifies
# per-user Bearer JWTs so traces are sandboxed by auth.uid().
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional extra server-to-server token (service identity, unscoped override):
AGENTDRIFT_MCP_TOKEN=
# Reject unauthenticated requests (auto-enforced in cloud when any secret set):
AGENTDRIFT_REQUIRE_AUTH=1
# Sync (psql/migration) URL, e.g. postgresql://postgres:password@db.PROJECT.supabase.co:5432/postgres
SYNC_DATABASE_URL=

HOST=127.0.0.1
PORT=8901
LOG_LEVEL=info
ENV=dev

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_FALLBACK_HASH=true
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_ENABLED=false

# Drift thresholds
DRIFT_SIMILARITY_THRESHOLD=0.85
DRIFT_AUTO_DETECT=true

# Dashboard (Next.js on :3000) CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
